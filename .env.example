# Knowledge Graph MCP Server Configuration

# Path to the Turtle (.ttl) file backing the knowledge graph.
# Optional — defaults to the bundled data/knowledge_graph.ttl
# KG_GRAPH_PATH=data/knowledge_graph.ttl

# RDF serialization format of KG_GRAPH_PATH (turtle, xml, n3, nt, json-ld, ...)
# Optional — defaults to "turtle"
# KG_GRAPH_FORMAT=turtle

# HTTP Transport Authentication (OAuth 2.0 — for Claude.ai and other MCP clients)
#
# When MCP_TRANSPORT is http/sse/streamable-http, set all three vars below to
# protect the endpoint with OAuth 2.0 authorization code + PKCE.
#
# Steps:
#   1. Choose any string for MCP_CLIENT_ID (e.g. "kg-mcp")
#   2. Generate a strong random secret for MCP_CLIENT_SECRET
#   3. Set MCP_SERVER_URL to the public HTTPS URL of this server
#   4. In Claude.ai -> Connectors -> add MCP server, enter:
#        URL                 = <MCP_SERVER_URL>/mcp
#        OAuth Client ID     = <MCP_CLIENT_ID>
#        OAuth Client Secret = <MCP_CLIENT_SECRET>
#
# Leave unset for local stdio use (no auth needed).
# MCP_CLIENT_ID=kg-mcp
# MCP_CLIENT_SECRET=your_strong_random_secret_here
# MCP_SERVER_URL=https://your-kg-mcp-server.onrender.com

# Transport selection (stdio | http | sse | streamable-http). Defaults to stdio.
# MCP_TRANSPORT=http

# Bind host for HTTP transport (required inside Docker/Render). Defaults to 127.0.0.1.
# FASTMCP_HOST=0.0.0.0
