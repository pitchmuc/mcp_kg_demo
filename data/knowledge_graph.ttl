@prefix crm: <http://example.org/crm#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
# Ontology (lightweight, informal — see docs/ontology in README)
#################################################################

crm:Account a rdfs:Class ;
    rdfs:comment "An enterprise customer organization." .

crm:Contact a rdfs:Class ;
    rdfs:comment "A person employed at an Account." .

